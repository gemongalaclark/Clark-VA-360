VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
# Gemini: no key here. Anything starting with VITE_ is published in the website's
# JavaScript, and a leaked key got its Google project suspended. All AI features call
# Supabase Edge Functions, which read GEMINI_API_KEY from Supabase secrets.

# Google Calendar OAuth (optional GIS Client ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Scheduler backend (leave blank in local Vite; /api/scheduler is proxied to :5001)
VITE_SCHEDULER_API_URL=

# BuhayVA Copilot: Make.com custom webhook URL (see BACKEND/BUHAYVA COPILOT/SETUP.md)
VITE_BV_MAKE_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id
