# ClarkFlow 360 — Supabase Edge Function secrets (never put these in the FRONTEND .env)
# Copy to .env (same folder), fill in, then from the repo root:
#   npx supabase secrets set --env-file "BACKEND/CLARKFLOW 360/supabase/functions/.env" --project-ref <your-project-ref>
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Add this exact URL under "Authorized redirect URIs" in the same OAuth client
GOOGLE_REDIRECT_URI=https://your-project-ref.supabase.co/functions/v1/cf-google-callback

# 32 random bytes, base64. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes stored Gmail tokens unreadable (you'd reconnect Gmail).
TOKEN_ENCRYPTION_KEY=

# GEMINI_API_KEY is already set in Supabase for your other functions. Leave it commented:
# `secrets set --env-file` pushes every line, so a placeholder here would overwrite the real key.
# GEMINI_API_KEY=
# Optional. Triage defaults to the same Flash chain as portfolio-chat
# (gemini-3.6-flash → gemini-3.5-flash-lite) with structured JSON output. Uncomment to override.
# GEMINI_MODEL=

# Where the OAuth callback sends the browser back to
CLARKFLOW_APP_URL=https://www.clarkva360.site/clarkflow
